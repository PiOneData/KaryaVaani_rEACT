# docker-compose environment for Karya Vaani + WhatsApp comms server.
# Copy to .env (same folder as docker-compose.yml) and fill in.
# NEVER commit the real .env — only this example with placeholder values.

# ---- Tenant identity (who this deployment is branded for) ----
# Karya Vaani ships single-tenant. Leave these blank and the UI names no client
# at all ('Customer Plant'); set them per deployment to brand it. VITE_* are read
# at BUILD time by the frontend (src/config/tenant.js); the unprefixed ones are
# read at RUNTIME by the backend and the docx generator (backend/tenant.js).
# Keep each pair in step.
TENANT_NAME=
TENANT_SITE=
TENANT_REGION=
TENANT_REGION_FULL=
TENANT_LOCATION_CODE=
VITE_TENANT_NAME=
VITE_TENANT_SITE=
VITE_TENANT_REGION=
VITE_TENANT_REGION_FULL=
VITE_TENANT_LEGAL_NAME=
VITE_TENANT_ZONE=
VITE_TENANT_ADDRESS=
VITE_TENANT_LOCATION_CODE=
VITE_TENANT_HQ=
VITE_TENANT_COMPLIANCE_EMAIL=
VITE_TENANT_HELPDESK_PHONE=

# ---- PostgreSQL store (containerised: service "postgres") ----
# Password for the karyavaani DB. Used by BOTH the postgres container and the
# backend's DATABASE_URL, so they stay in sync. Set a strong value here / as a
# secret (the compose file falls back to a weak dev default if this is unset).
POSTGRES_PASSWORD=change-me-strong-password

# ---- Mailer (VAANI mailer, Office365 SMTP) ----
# The mailbox password — keep out of the repo; set as a secret.
EMAIL_HOST_PASSWORD=

# Shared secret between the backend and the comms server (keep private).
COMMS_API_KEY=change-me-shared-secret

# ---- Meta WhatsApp Cloud API ----
# From Meta for Developers > your app > WhatsApp > API Setup.
# Leave blank to run the gateway in mock mode (messages logged, not sent).
META_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Webhook verification token — you choose this value, then enter the SAME
# value in the Meta dashboard webhook configuration screen.
META_VERIFY_TOKEN=karya-vaani-verify

# App secret enables X-Hub-Signature-256 validation of inbound webhooks.
META_APP_SECRET=
COMMS_VERIFY_SIGNATURE=false

# TEST ONLY: redirect every outbound WhatsApp message to this single
# number so nothing reaches real workers. Leave empty in production.
WHATSAPP_TEST_RECIPIENT=919500200300
